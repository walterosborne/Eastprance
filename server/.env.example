server=localhost
schema=dbo
database=your_database_name
user=your_database_user
password=your_database_password
# Optional local dev file: copy this file to server/.env. If server/.env is present,
# its values override existing shell variables. If it is absent, the app falls back
# to real environment variables instead.
# Optional roster DB override.
ROSTER_SERVER=
ROSTER_SCHEMA=dbo
ROSTER_DATABASE=
ROSTER_USER=
ROSTER_PASSWORD=
# Microsoft Entra app-registration metadata. In OpenShift these are primarily consumed by
# the OAuth2 Proxy sidecar. The Object ID is retained for inventory and is not the OAuth client ID.
ENTRA_APPLICATION_ID=
ENTRA_OBJECT_ID=
ENTRA_DIRECTORY_ID=
# OAuth2 Proxy also requires the Entra client-secret value and a separate cookie secret.
# Do not commit either value; provide them through the qmiscorecard-entra OpenShift secret.
ENTRA_CLIENT_SECRET=
OAUTH2_PROXY_COOKIE_SECRET=
# Leave this true for local dev if you want the N35589 fallback when no identity is forwarded.
ALLOW_HARDCODED_IDENTITY_FALLBACK=true
# Dev binds to localhost. Production containers bind to 0.0.0.0 automatically.
API_PORT=3002
PORT=8080
# Optional SQL cache schedule for deployed dashboards.
SQL_DATASET_CACHE_TIMEZONE=America/New_York
SQL_DATASET_CACHE_REFRESH_HOUR=5
SQL_DATASET_CACHE_REFRESH_MINUTE=0
